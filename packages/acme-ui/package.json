{
  "name": "@acme/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./render": {
      "types": "./src/render.ts",
      "default": "./src/render.ts"
    },
    "./editor": {
      "types": "./src/editor.ts",
      "default": "./src/editor.ts"
    },
    "./validation": {
      "types": "./src/validation.ts",
      "default": "./src/validation.ts"
    }
  },
  "devDependencies": {
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@inflatable-cookie/poodle-svelte": "0.2.2",
    "@inflatable-cookie/underlay": "git+ssh://git@github.com/inflatable-cookie/underlay.git#v0.9.6",
    "marked": "^18.0.9"
  }
}
