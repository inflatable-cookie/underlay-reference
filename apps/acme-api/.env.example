# Acme API environment configuration (example).
# Copy to .env and fill in real values. Only the variables you need — most
# have sensible dev defaults.

# --- Core ---
# Postgres connection string (required).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/acme

# Environment name: local | dev | development | test | production
ENVIRONMENT=local

# --- Auth ---
# Ed25519 JWT keys, base64 (generate with: cargo run -p acme-auth --bin generate-jwt-env)
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
# Required outside local/dev/test: encrypts stored TOTP secrets.
ENCRYPTION_KEY=

# --- Trusted proxies (client IP resolution) ---
# Only trust X-Forwarded-For / X-Real-IP when both are set.
TRUST_PROXY_HEADERS=false
# Comma-separated IPs/CIDRs of your reverse proxies.
TRUSTED_PROXIES=

# --- Rate limiting ---
# in_memory (default, single instance) or redis (distributed).
RATE_LIMIT_BACKEND=in_memory
REDIS_URL=redis://localhost:6379

# --- Blob storage (media uploads) ---
# Development uses the bundled MinIO shape automatically; production builds a
# real S3 adapter from these. AWS credentials come from the standard AWS
# credential chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars, shared
# config, or an instance/task role) — never from app config.
#
# Required in production (unless ACME_ALLOW_NOOP_BLOB=1):
ACME_S3_BUCKET=
# Optional (defaults shown / empty = unset):
ACME_S3_REGION=us-east-1
# Custom endpoint for S3-compatible storage (R2, MinIO, Ceph, ...).
ACME_S3_ENDPOINT=
# Public base URL for serving objects (CDN or bucket website endpoint).
ACME_S3_PUBLIC_URL_BASE=
# Set to 1 for path-style addressing (most S3-compatible endpoints need it).
ACME_S3_PATH_STYLE=
# Explicit opt-in to run production without media storage (uploads discarded).
ACME_ALLOW_NOOP_BLOB=
