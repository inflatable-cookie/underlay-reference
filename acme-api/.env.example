# Acme API Environment Configuration
#
# Copy this file to .env and adjust values for your environment.
# Do not commit .env files with secrets to version control.

# =============================================================================
# Server Configuration
# =============================================================================

# Environment: local, dev, staging, production
ENVIRONMENT=local

# Server bind address
HOST=localhost

# Server port
PORT=41001

# Application URL (used for email links, OAuth redirects, etc.)
APP_URL=http://localhost:41001

# Support email address (displayed in error messages, etc.)
SUPPORT_EMAIL=support@acme.local

# =============================================================================
# Database
# =============================================================================

# PostgreSQL connection URL
DATABASE_URL=postgres://root@127.0.0.1:5432/acme

# =============================================================================
# Logging
# =============================================================================

# Rust log level (trace, debug, info, warn, error)
# Use comma-separated module=level pairs for fine-grained control
# Examples:
#   RUST_LOG=debug
#   RUST_LOG=info,sqlx=warn,tower_http=debug
RUST_LOG=debug

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed origins (comma-separated). If empty in local/dev, mirrors request origin.
# Example: https://admin.acme.com,https://acme.com
CORS_ORIGINS=

# =============================================================================
# Cookie Configuration
# =============================================================================

# Cookie domain (e.g., ".acme.com" for cross-subdomain). Empty for current host only.
COOKIE_DOMAIN=

# Set Secure flag on cookies (should be true in production with HTTPS)
COOKIE_SECURE=false

# Cookie name prefix (e.g., "acme_" produces "acme_refresh_token")
COOKIE_PREFIX=acme_

# Refresh token max age in seconds (default: 7 days = 604800)
REFRESH_TOKEN_MAX_AGE=604800

# =============================================================================
# Email Configuration
# =============================================================================

# Email adapter: dev_capture (stores in DB), smtp, sendgrid, noop
# In local/dev, defaults to dev_capture if not set
EMAIL_ADAPTER=dev_capture

# Default "from" address for outgoing emails
EMAIL_DEFAULT_FROM=noreply@acme.local

# =============================================================================
# Blob Storage (File Uploads)
# =============================================================================

# Local directory for blob storage (development)
BLOB_STORAGE_DIR=./dev-uploads

# Base URL for serving blobs (if different from API URL)
# BLOB_SERVE_URL=http://localhost:41001/v1/dev-blobs

# =============================================================================
# JWT Authentication
# =============================================================================

# JWT signing keys (Ed25519)
# Generate with: openssl genpkey -algorithm ED25519 | openssl pkey -outform DER | base64
# Public key: openssl pkey -pubout -outform DER | tail -c 32 | base64 | tr '+/' '-_' | tr -d '='
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=

# JWT claim validation
AUTH_JWT_ISSUER=acme
AUTH_JWT_AUDIENCE=acme-api

# Token lifetimes
AUTH_ACCESS_TOKEN_LIFETIME_MINUTES=15
AUTH_REFRESH_TOKEN_LIFETIME_DAYS=30

# Clock skew tolerance for token validation (seconds)
AUTH_JWT_LEEWAY_SECONDS=30

# OAuth token encryption key (32-byte base64, required for storing OAuth refresh tokens)
# Generate with: openssl rand -base64 32
AUTH_OAUTH_SECRET_KEY=

# =============================================================================
# OAuth Providers (Optional)
# =============================================================================

# Google OAuth
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:41001/v1/auth/google/callback

# =============================================================================
# WebAuthn / Passkeys Configuration
# =============================================================================

# Relying Party ID (typically your domain, e.g., "acme.com")
WEBAUTHN_RP_ID=localhost

# Relying Party name (displayed to users during registration)
WEBAUTHN_RP_NAME=Acme

# Relying Party origin (must match the origin users authenticate from)
WEBAUTHN_RP_ORIGIN=http://localhost:41002

# =============================================================================
# Password Hashing (Argon2)
# =============================================================================

# These are optional - sensible defaults are used if not set.
# Increase for stronger security at the cost of CPU time.

# ARGON2_ITERATIONS=3
# ARGON2_MEMORY_KB=65536
# ARGON2_PARALLELISM=4
