# Acme API (local dev)

# Server
ENVIRONMENT=local
HOST=127.0.0.1
PORT=40011

# Database
DATABASE_URL=postgres://root@127.0.0.1:5432/acme

# Logging
# RUST_LOG=debug,sqlx=warn
RUST_LOG=debug

# Email adapter (placeholder for future wiring)
# EMAIL_ADAPTER=dev_capture

# Auth keys (required once auth endpoints are enabled)
# Generate these via your project tooling when you enable auth.
# AUTH_JWT_PRIVATE_KEY=
# AUTH_JWT_PUBLIC_KEY=

# JWT claim validation
# AUTH_JWT_ISSUER=acme
# AUTH_JWT_AUDIENCE=acme-api
# AUTH_ACCESS_TOKEN_LIFETIME_MINUTES=15
# AUTH_REFRESH_TOKEN_LIFETIME_DAYS=30
# AUTH_JWT_LEEWAY_SECONDS=30

# OAuth token encryption (recommended if storing refresh tokens)
# AUTH_OAUTH_SECRET_KEY=

# Optional OAuth (future)
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_REDIRECT_URI=

# Legacy fallbacks (deprecated)
#
# These are accepted by the current codebase for backwards compatibility.
# Prefer the standard Underlay names above.
# ACME_ENV=local
# ACME_BIND_ADDR=127.0.0.1
# ACME_PORT=40011
# ACME_DATABASE_URL=postgres://root@127.0.0.1:5432/acme
