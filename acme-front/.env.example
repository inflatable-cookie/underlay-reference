# Acme Front (SvelteKit) - Local Development
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL (for server-side requests)
PUBLIC_API_URL=http://localhost:40011

# =============================================================================
# Public URLs (for client-side redirects)
# =============================================================================

# Public frontend URL (this app)
PUBLIC_FRONT_URL=http://localhost:40013

# Admin app URL (for admin links)
PUBLIC_ADMIN_URL=http://localhost:40012

# =============================================================================
# Feature Flags (optional)
# =============================================================================

# Enable debug mode for auth flows
# PUBLIC_AUTH_DEBUG=true
