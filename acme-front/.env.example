# Acme Front (SvelteKit) Environment Configuration
#
# Copy this file to .env and adjust values for your environment.
# Variables prefixed with PUBLIC_ are exposed to the browser.

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL (for server-side and client-side requests)
PUBLIC_API_URL=http://localhost:41001

# API version (date format, e.g., 2025-01-01)
# PUBLIC_API_VERSION=2025-01-01

# =============================================================================
# Public URLs (for client-side redirects and links)
# =============================================================================

# Public frontend URL (this app)
PUBLIC_FRONT_URL=http://localhost:41003

# Admin app URL (for admin links)
PUBLIC_ADMIN_URL=http://localhost:41002

# =============================================================================
# Feature Flags (optional)
# =============================================================================

# Enable debug mode for auth flows (shows extra logging)
# PUBLIC_AUTH_DEBUG=true
