{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "baseUrl": "src",
    "paths": {
      "@decodelabs/underlay/*": ["../../../underlay/ts/src/*"]
    },
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src"]
}
